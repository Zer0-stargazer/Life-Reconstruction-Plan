# ===== Supabase 数据库 =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== AI 模型配置 =====
# OpenAI 兼容接口（baseUrl + key + model 三件套）
AI_API_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=your-api-key-here
AI_MODEL=doubao-seed-2-0-lite-260215

# 推理型模型（GLM-5 等）默认会先输出一大段思维链再给正文。
# 本项目的 SSE 只取 delta.content，思维链不会显示，但会显著拖慢首字：
# 实测同一请求 开启 112 秒 / 关闭 6 秒。
# 默认关闭；需要深度推理时设为 1。
AI_THINKING=0

# ===== 开发者后台密码（必须设置，否则无法访问 /admin） =====
DEV_PASSWORD=your-secret-dev-password

# ===== 会话签名密钥（用户登录态令牌的 HMAC 密钥） =====
# 不设置时会回退用 DEV_PASSWORD；生产环境两者都没有则拒绝签发登录态。
# 建议：openssl rand -hex 32
SESSION_SECRET=your-random-session-secret

# ===== 运行配置 =====
NODE_ENV=development
HOSTNAME=localhost
PORT=5000