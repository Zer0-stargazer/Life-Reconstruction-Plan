# ===== Supabase 数据库 =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== 内置 AI 配置（三项必须一起填，缺一项内置 AI 会直接报"未配置"）=====
# OpenAI 兼容接口（baseUrl + key + model 三件套）。
# 项目不再内置任何厂商地址/模型，按你实际用的服务商填。
AI_API_URL=https://your-openai-compatible-endpoint/v1
AI_API_KEY=your-api-key-here
AI_MODEL=your-model-id

# 推理型模型（GLM-5 等）默认会先输出一大段思维链再给正文。
# 本项目的 SSE 只取 delta.content，思维链不会显示，但会显著拖慢首字：
# 实测同一请求 开启 112 秒 / 关闭 6 秒。
# 默认关闭；需要深度推理时设为 1。
AI_THINKING=0

# ===== 内置 AI 备用源（可选，但强烈建议配置）=====
# 主源"未产出内容即失败"（如 502 / 连接失败）时自动切换到这里，避免"一半概率坏"。
# 同样是 OpenAI 兼容接口，三件套齐全才生效；留空则不加容错（行为同从前）。
# 仅作用于内置 AI；用户在「我的」页自带的 Key（BYOK）不参与切换。
AI_FALLBACK_URL=
AI_FALLBACK_KEY=
AI_FALLBACK_MODEL=

# ===== 开发者后台密码（必须设置，否则无法访问 /admin） =====
# 生产环境必须 ≥24 位随机串（<16 位时生产环境会拒绝所有后台口令登录）。生成：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEV_PASSWORD=replace-with-24+-char-random-string

# ===== 会话签名密钥（用户登录态令牌的 HMAC 密钥） =====
# 只读此变量（不再回退 DEV_PASSWORD）；生产环境必须设置且 ≥32 字符，否则拒绝签发/校验登录态（500）。
# 开发环境缺失或不足 32 字符时：打印警告并使用进程启动时随机生成的临时密钥（重启后登录态失效）。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ===== 解锁弹窗联系方式（可选）=====
# 访客在解锁弹窗中看到的“获取授权码”联系方式（微信号 / 邮箱等）。
# 留空则不显示该行；修改后需重新构建（NEXT_PUBLIC_ 变量在构建时内联）。
NEXT_PUBLIC_CONTACT=

# ===== 邮件验证码通道（账号体系 v2）=====
# MAIL_PROVIDER 取值：
#   console（默认）— 不发真信，验证码经接口 debugCode 回传页面（不进日志），仅本地开发可用；
#                    NODE_ENV=production 下视为未配置，生产必须用 resend
#   resend        — 调用 Resend HTTP API，需 RESEND_API_KEY + MAIL_FROM
# 不设 MAIL_PROVIDER 时就是 console 模式，验证码接口可跑通但用户收不到信。
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=人生沙盘 <noreply@your-domain.com>

# ===== 短信验证码通道（预留，当前不启用）=====
# 国内短信需企业主体 + ICP 备案 + 签名模板报备，个人难申请且按条计费。
# 手机号目前只作为绑定项存进资料（后台可见、脱敏展示），不发码。
# 接通道时：设 SMS_PROVIDER=<服务商> 并在 src/lib/sms.ts 加对应分支，业务代码不用改。
SMS_PROVIDER=console

# ===== 注册人机验证 Cloudflare Turnstile（防刷号）=====
# 两个都留空 = 跳过验证（开发友好，服务端会 warn 一次）；只配一个 = 配置错误，注册返回 500。
# NEXT_PUBLIC_ 变量在构建时内联，修改后需重新构建。
# 本地联调可用 Cloudflare 官方测试 key（总是通过）：
#   站点 key 1x00000000000000000000AA  /  密钥 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ===== 运行配置 =====
HOSTNAME=localhost
PORT=5000