# ===== Supabase 数据库 =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== AI 模型配置（默认使用豆包） =====
AI_API_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=your-api-key-here
AI_MODEL=doubao-seed-2-0-lite-260215

# ===== 开发者后台密码（必须设置，否则无法访问 /admin） =====
DEV_PASSWORD=your-secret-dev-password

# ===== 会话签名密钥（用户登录态令牌的 HMAC 密钥） =====
# 不设置时会回退用 DEV_PASSWORD；生产环境两者都没有则拒绝签发登录态。
# 建议：openssl rand -hex 32
SESSION_SECRET=your-random-session-secret

# ===== 运行配置 =====
NODE_ENV=development
HOSTNAME=localhost
PORT=5000