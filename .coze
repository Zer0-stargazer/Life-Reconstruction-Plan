[project]
requires = [ "nodejs-24" ]
template = "nextjs"
version = "legacy"
appliedPatches = [ "nextjs/validate@0.0.20" ]

[dev]
build = [ "pnpm", "install" ]
run = [ "pnpm", "run", "dev" ]
deps = [ "git" ]
validate = [ "pnpm", "run", "validate" ]

[deploy]
build = [ "pnpm", "run", "build" ]
run = [ "pnpm", "run", "start" ]
deps = [ "git" ]
